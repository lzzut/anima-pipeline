# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# COMFY_URL=http://127.0.0.1:8188
# COMFY_DIR=
# COMFY_PYTHON=
# COMFY_AUTOSTART=0
# ANIMA_TOKENIZER_ROOT=
# DEEPSEEK_WEB_BUDGET_CNY=0.20
